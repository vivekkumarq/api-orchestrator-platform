# Copy to .env and adjust. docker-compose reads this file automatically.
# Every variable here is optional: the defaults shown are what the application
# uses when the variable is unset.

# ---- ports (docker-compose only) --------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ---- database ---------------------------------------------------------------
# Consumed by the db service and by the backend's prod profile.
DB_NAME=orchestrator
DB_USERNAME=orchestrator
DB_PASSWORD=orchestrator
# Full JDBC URL. Compose overrides this to point at the db service.
# Default profile (no SPRING_PROFILES_ACTIVE): jdbc:h2:mem:orchestrator;DB_CLOSE_DELAY=-1
# Prod profile:                                jdbc:postgresql://localhost:5432/orchestrator
DB_URL=jdbc:postgresql://localhost:5432/orchestrator

# ---- backend ----------------------------------------------------------------
# Port the Spring Boot process listens on inside its container or on the host.
SERVER_PORT=8080
# Set to "prod" to use PostgreSQL instead of the in-memory H2 database.
SPRING_PROFILES_ACTIVE=
# Comma-separated origins allowed to call /api/**.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# H2 web console at /h2-console. Forced off in the prod profile.
H2_CONSOLE_ENABLED=true
# Log level for this application's own packages.
LOG_LEVEL=INFO

# ---- execution engine -------------------------------------------------------
# Timeout used when a request does not specify one.
EXECUTOR_DEFAULT_TIMEOUT_MS=10000
# Ceiling on the timeout a request may ask for.
EXECUTOR_MAX_TIMEOUT_MS=60000
# Largest response body buffered in memory. Anything beyond is truncated.
EXECUTOR_MAX_RESPONSE_BYTES=1048576
# Characters of the response body kept in the history table.
EXECUTOR_MAX_PERSISTED_BODY_CHARS=20000
# Ceiling on the number of retries a request may ask for.
EXECUTOR_MAX_RETRIES=5

# ---- outbound request safety ------------------------------------------------
# This service fetches arbitrary user-supplied URLs, which makes it a
# server-side request forgery primitive by design.
#
# true  - loopback and private ranges are reachable. Correct for local use,
#         where the point is calling a service on localhost.
# false - hosts resolving to loopback, link-local, site-local, any-local or
#         multicast addresses are refused. Use this for any instance someone
#         you do not trust can reach. It is the default in the prod profile.
ALLOW_PRIVATE_NETWORKS=true
# URI schemes the executor will dial.
ALLOWED_SCHEMES=http,https
# Always refused, whatever ALLOW_PRIVATE_NETWORKS says.
BLOCKED_HOSTS=169.254.169.254,metadata.google.internal

# ---- frontend ---------------------------------------------------------------
# Where the UI sends its API calls. Vite inlines this at build time, so
# changing it needs a rebuild, not a restart.
VITE_API_BASE_URL=http://localhost:8080
